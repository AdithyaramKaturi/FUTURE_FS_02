# ==========================================
# LEADFLOW CRM — ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------
# Server Environment (server/.env)
# -----------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow-crm

# JWT Secret Key (generate a strong 32+ character random string in production)
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_EXPIRES_IN=24h

# Allowed Client Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Admin Initial Setup Credentials
DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your_secure_password_here

# -----------------
# Client Environment (client/.env)
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api
