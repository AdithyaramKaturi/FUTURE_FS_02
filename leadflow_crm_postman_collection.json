{
  "info": {
    "name": "LeadFlow CRM API",
    "_postman_id": "leadflow-crm-api-collection",
    "description": "Postman API Collection for testing LeadFlow CRM RESTful endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "followUpId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('authToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@leadflow.io\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Admin (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Admin Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Public Inquiries",
      "item": [
        {
          "name": "Submit Public Lead Inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Rivera\",\n  \"email\": \"alex.rivera@example.com\",\n  \"phone\": \"+1 (555) 987-6543\",\n  \"company\": \"Rivera Design Labs\",\n  \"serviceInterested\": \"Web Development\",\n  \"message\": \"We need a multi-page interactive web application for our new product lineup launch.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/leads",
              "host": ["{{baseUrl}}"],
              "path": ["public", "leads"]
            }
          }
        }
      ]
    },
    {
      "name": "Leads Management",
      "item": [
        {
          "name": "List Leads (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads?page=1&limit=10&status=all&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["leads"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "all" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Create Lead (Manual Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('leadId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jonathan Cross\",\n  \"email\": \"jcross@crossventure.com\",\n  \"phone\": \"555-888-9999\",\n  \"company\": \"Cross Venture Group\",\n  \"serviceInterested\": \"Full-Stack App\",\n  \"message\": \"Looking to build a customer portal with analytics.\",\n  \"source\": \"referral\",\n  \"status\": \"new\",\n  \"value\": 14000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": ["{{baseUrl}}"],
              "path": ["leads"]
            }
          }
        },
        {
          "name": "Get Lead By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["leads", "{{leadId}}"]
            }
          }
        },
        {
          "name": "Update Lead Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"contacted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["leads", "{{leadId}}", "status"]
            }
          }
        },
        {
          "name": "Add Note To Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Had initial phone discovery call. Budget and timeline are confirmed.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["leads", "{{leadId}}", "notes"]
            }
          }
        },
        {
          "name": "Schedule Follow-up For Lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('followUpId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Send proposal document and agreement contract.\",\n  \"scheduledAt\": \"2026-11-01T14:30:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["leads", "{{leadId}}", "follow-ups"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics Overview KPIs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/overview",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "overview"]
            }
          }
        },
        {
          "name": "Get Leads Over Time",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/leads-over-time",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "leads-over-time"]
            }
          }
        },
        {
          "name": "Get Leads By Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/leads-by-status",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "leads-by-status"]
            }
          }
        },
        {
          "name": "Get Leads By Source",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/leads-by-source",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "leads-by-source"]
            }
          }
        }
      ]
    }
  ]
}
